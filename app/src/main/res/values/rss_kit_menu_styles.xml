<style name="RssPageSubtitle"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">6dp</item><item name="android:textColor">@color/rss_muted</item><item name="android:textSize">14sp</item></style>
