<style name="RssSectionTitle"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">26dp</item><item name="android:layout_marginBottom">8dp</item><item name="android:textColor">@color/rss_gold</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item></style>
